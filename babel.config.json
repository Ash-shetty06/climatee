{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "node": "current"
      }
    }],
    ["@babel/preset-react", {
      "runtime": "automatic"
    }]
  ],
  "env": {
    "development": {
      "presets": [
        ["@babel/preset-typescript", {
          "isTSX": true,
          "allExtensions": true,
          "onlyRemoveTypeImports": true
        }]
      ]
    }
  }
}
